generator client {
  provider = "prisma-client-js"
}

// Blog Post Comments
model PostComment {
  id        Int      @id @default(autoincrement())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    Int
  name      String
  content   String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
}

datasource db {
  provider = "sqlite" // dev; switch to postgresql in prod
  url      = env("DATABASE_URL")
}

model User {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  password  String
  role      String   @default("EDITOR")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id           Int                    @id @default(autoincrement())
  slug         String                 @unique
  translations CategoryTranslation[]
  posts        Post[]
  createdAt    DateTime               @default(now())
  updatedAt    DateTime               @updatedAt
}

model CategoryTranslation {
  id         Int      @id @default(autoincrement())
  locale     String
  name       String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId Int

  @@unique([categoryId, locale])
}

model Post {
  id            Int               @id @default(autoincrement())
  date          DateTime?
  imageUrl      String?
  isAd          Boolean           @default(false)
  adPlacement   String            @default("all")
  adZone        String?           // top_ad, side_ad, blog_specific
  adBlogSlug    String?
  adBlogPostId  Int?              // Link to specific blog post
  ctaUrl        String?
  category      Category?         @relation(fields: [categoryId], references: [id])
  categoryId    Int?
  translations  PostTranslation[]
  comments      PostComment[]
  reviewStatus  String            @default("submitted")
  published     Boolean           @default(false)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model PostTranslation {
  id          Int      @id @default(autoincrement())
  locale      String
  title       String
  excerpt     String?
  content     String?
  adText      String?
  ctaText     String?
  slug        String
  metaTitle   String?
  metaDescription String?
  categoryLabel String?
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId      Int

  @@unique([postId, locale])
  @@unique([slug, locale])
}

model GalleryImage {
  id           Int                        @id @default(autoincrement())
  imageUrl     String?
  videoUrl     String?
  youtubeUrl   String?
  type         String                     @default("image")
  order        Int                        @default(0)
  group        GalleryGroup?              @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId      Int?
  translations GalleryImageTranslation[]
  createdAt    DateTime                   @default(now())
  updatedAt    DateTime                   @updatedAt
}

model GalleryImageTranslation {
  id        Int          @id @default(autoincrement())
  locale    String
  caption   String
  description String?
  image     GalleryImage @relation(fields: [imageId], references: [id], onDelete: Cascade)
  imageId   Int

  @@unique([imageId, locale])
}

model Service {
  id           Int                  @id @default(autoincrement())
  link         String?
  order        Int                  @default(0)
  phone        String?
  email        String?
  translations ServiceTranslation[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model ServiceTranslation {
  id           Int      @id @default(autoincrement())
  locale       String
  title        String
  description  String?
  details      String?
  slug         String?
  metaTitle    String?
  metaDescription String?
  service      Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  serviceId    Int

  @@unique([serviceId, locale])
  @@unique([slug, locale])
}

model ContactRequest {
  id        Int           @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String
  status    String        @default("NEW")
  createdAt DateTime      @default(now())
}

model SiteSettings {
  id                      Int      @id @default(1)
  defaultLocale           String   @default("en")
  contactEmail            String?
  heroBackgroundUrl       String?
  agroecologyBackgroundUrl String?
  blogCommentsEmail       String?
  bookOrdersEmail         String?
  heroBox2Slug            String?
  heroBox3Slug            String?
}

model AboutPage {
  id           Int                    @id @default(1)
  translations AboutPageTranslation[]
}

model AboutPageTranslation {
  id        Int       @id @default(autoincrement())
  locale    String
  heading   String
  body      String
  points    String?
  about     AboutPage @relation(fields: [aboutId], references: [id], onDelete: Cascade)
  aboutId   Int

  @@unique([aboutId, locale])
}

model ContactPage {
  id           Int                      @id @default(1)
  translations ContactPageTranslation[]
  email        String?
  phone        String?
}

model ContactPageTranslation {
  id        Int         @id @default(autoincrement())
  locale    String
  heading   String
  sub       String?
  contact   ContactPage @relation(fields: [contactId], references: [id], onDelete: Cascade)
  contactId Int

  @@unique([contactId, locale])
}

model ServicesPage {
  id           Int                        @id @default(1)
  translations ServicesPageTranslation[]
}

model ServicesPageTranslation {
  id             Int           @id @default(autoincrement())
  locale         String
  heading        String
  sub            String?
  servicesPage   ServicesPage  @relation(fields: [servicesPageId], references: [id], onDelete: Cascade)
  servicesPageId Int

  @@unique([servicesPageId, locale])
}

model Book {
  id           Int               @id @default(autoincrement())
  price        String?
  coverUrl     String?
  page1Url     String?
  page2Url     String?
  link         String?
  order        Int               @default(0)
  isPreorder   Boolean           @default(false)
  quality      String?
  status       String            @default("INSTOCK") // PREBOOK, INSTOCK, SOLD_OUT
  stock        Int               @default(0)
  translations BookTranslation[]
  orderItems   OrderItem[]
  comments     BookComment[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

model BookTranslation {
  id              Int    @id @default(autoincrement())
  locale          String
  name            String
  description     String?
  slug            String
  metaTitle       String?
  metaDescription String?
  book            Book   @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId          Int

  @@unique([bookId, locale])
  @@unique([slug, locale])
}

// Orders and Comments
model Order {
  id            Int          @id @default(autoincrement())
  name          String
  email         String?
  phone         String
  address       String
  city          String?
  pincode       String?
  notes         String?
  preorder      Boolean      @default(false)
  status        String       @default("PENDING") // PENDING, CONFIRMED, CANCELLED, FULFILLED
  paymentStatus String       @default("UNPAID")  // UNPAID, PAID
  paymentRef    String?
  paymentProofUrl String?
  total         String?
  items         OrderItem[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  book      Book   @relation(fields: [bookId], references: [id])
  bookId    Int
  quantity  Int    @default(1)
  price     String? // snapshot of price at order time
}

model GalleryGroup {
  id        Int            @id @default(autoincrement())
  title     String?
  date      DateTime?
  order     Int            @default(0)
  images    GalleryImage[]
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model BookComment {
  id        Int      @id @default(autoincrement())
  book      Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  bookId    Int
  name      String
  content   String
  approved  Boolean  @default(true)
  createdAt DateTime @default(now())
}
